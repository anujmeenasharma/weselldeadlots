# --- Sanity CMS ---
# Public identifiers (safe in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
NEXT_PUBLIC_SITE_URL=https://weselldeadlots.com

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Viewer token — enables draft previews from the Studio's Presentation tool
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=
# Editor token — used by the admin panel (/admin) to save changes, and by `npm run sanity:seed`
SANITY_API_WRITE_TOKEN=

# --- Existing integrations ---
NEXT_PUBLIC_SHOPIFY_STORE_URL=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=
SHOPIFY_ADMIN_API_ACCESS_ID=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Admin panel (/admin) ---
# Password for the website admin panel
ADMIN_PASSWORD=
# Random string, at least 32 characters (signs login sessions)
ADMIN_SESSION_SECRET=

# Shopify app (Dev Dashboard) credentials, used to mint short-lived Admin API tokens
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
